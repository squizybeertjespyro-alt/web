# ============================================================
# COPY THIS FILE TO .env.local AND FILL IN YOUR VALUES
# Never commit .env.local to git!
# ============================================================

# Database (SQLite - no setup needed, just leave this as is)
DATABASE_URL="file:./dev.db"

# Your site's public URL (no trailing slash)
NEXT_PUBLIC_BASE_URL="https://hardduckmarket.xyz"

# ── STRIPE ──────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# Get this after setting up a webhook at:
# https://dashboard.stripe.com/webhooks
# Endpoint URL: https://hardduckmarket.xyz/api/webhooks/stripe
# Events to listen for: payment_intent.succeeded, payment_intent.payment_failed
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── COINBASE COMMERCE ────────────────────────────────────────
# Get these from https://beta.commerce.coinbase.com/settings/security
COINBASE_COMMERCE_API_KEY="..."
COINBASE_COMMERCE_WEBHOOK_SECRET="..."

# ── RESEND (email) ────────────────────────────────────────────
# Sign up free at https://resend.com — 3,000 emails/month free
# Add and verify your domain in Resend dashboard
RESEND_API_KEY="re_..."
EMAIL_DOMAIN="hardduckmarket.xyz"
